# assessment-service (NestJS) — local/deploy configuration
#
# Copy to .env.local and fill in. Never commit the filled-in file.

PORT=5000
NODE_ENV=development

# Applies db/migrations/*.sql at boot, recording them in assessment_db_version.
# Leave on: it is the only supported way to create or update the schema.
RUN_MIGRATIONS=true

# ── Database ────────────────────────────────────────────────────────────────
# exam-engine must migrate this database first (see 012's ordering note).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change-me
DB_NAME=originbi_technical
DATABASE_URL=postgres://postgres:change-me@localhost:5432/originbi_technical?sslmode=disable

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Peer services ───────────────────────────────────────────────────────────
ASSESSMENT_SERVICE_URL=http://localhost:5000
TECH_FRONTEND_URL=http://localhost:3000
# From the sibling OriginBi platform — required for login and student profile.
STUDENT_SERVICE_URL=http://localhost:4004
NEXT_PUBLIC_STUDENT_SERVICE_URL=http://localhost:4004

# ── Authentication & authorization ──────────────────────────────────────────
# Defaults to ON. Set to "off" ONLY for local development; the service refuses
# to start with auth disabled when NODE_ENV=production.
#
# This flag gates BOTH global guards:
#   - CognitoAuthGuard verifies the bearer token  (401 without one)
#   - RolesGuard resolves the caller's `users` row and enforces @Roles('ADMIN')
#     on every /api/admin/* controller                      (403 for non-admins)
#
# With it off, admin endpoints are completely unprotected and identity falls
# back to the client-supplied X-User-Context header. Never ship that.
ASSESSMENT_AUTH=on
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_CLIENT_ID=

# ── AWS (SES email) ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
EMAIL_FROM=no-reply@example.com
EMAIL_SEND_FROM_NAME='Origin BI Mind Works'

# ── Scoring ─────────────────────────────────────────────────────────────────
# Pass mark as a percentage. Must match exam-engine's CERT_PASS_PERCENT, or a
# candidate can show as passed on one screen and failed on another.
CERT_PASS_PERCENT=90

# ── Cloudflare R2 (object storage) ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
