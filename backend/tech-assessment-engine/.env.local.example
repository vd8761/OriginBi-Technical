# tech-assessment-engine — local/deploy configuration
#
# Copy to .env.local and fill in. Never commit the filled-in file: .gitignore
# already excludes .env* apart from these examples.

TECH_ENGINE_PORT=5001

# ── Database ────────────────────────────────────────────────────────────────
# Shares a database with exam-engine and assessment-service. exam-engine must
# have migrated it first: the tech_* tables carry foreign keys to users(id),
# which its goose baseline creates.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change-me
DB_NAME=originbi_technical
DATABASE_URL=postgres://postgres:change-me@localhost:5432/originbi_technical?sslmode=disable

# ── Authentication (REQUIRED) ───────────────────────────────────────────────
# Every /api/assessment route verifies a Cognito access token and resolves the
# acting user from it. The service REFUSES TO START if these are unset or the
# pool is unreachable — that is deliberate. It previously ran with no
# authentication at all, which let any caller start and submit an exam as any
# user. If the service exits on boot with "cognito verifier init failed",
# these values are missing or wrong; do not work around it by disabling auth.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. Empty means no cross-origin browser access.
# Do not use "*": credentialed requests require a specific origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
