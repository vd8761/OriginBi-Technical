# auth-service — local/deploy configuration
#
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# This service owns identity for the technical platform: sign-in, sessions,
# registration, the student profile the header reads, and outbound email. It
# replaces the sibling originbi platform's auth-service (:4002) and the slice
# of its student-service (:4004) this platform used. Nothing here talks to the
# sibling repo any more.

AUTH_SERVICE_PORT=4002
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# The same originbi_technical database the other backends use. This service
# runs no migrations: exam-engine creates users/registrations, and
# assessment-service creates the reference tables and user_action_logs.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change-me
DB_NAME=originbi_technical

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. Do not use "*": credentialed requests need a
# specific origin. In production this is your frontend's https origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Cognito (REQUIRED — the service refuses to start without these) ─────────
# This platform has its OWN user pool, separate from the sibling originbi one.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Sign-in uses the Admin* APIs, so IAM credentials are required even to log a
# user in. The IAM user needs cognito-idp:AdminInitiateAuth, AdminCreateUser,
# AdminSetUserPassword, AdminAddUserToGroup, AdminGetUser,
# AdminListGroupsForUser, ForgotPassword, GetUser and GlobalSignOut on the pool
# — plus ses:SendEmail if email is enabled below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Points Cognito at a simulator instead of AWS. Set ONLY by local-dev; the
# service exits at boot if this is set while NODE_ENV=production.
# COGNITO_ENDPOINT=http://localhost:9229

# ── Email (SES v2) ──────────────────────────────────────────────────────────
# Welcome and certificate mail. With EMAIL_FROM unset the service logs and
# skips sending rather than failing the request that triggered it.
EMAIL_FROM=
EMAIL_SEND_FROM_NAME='Origin BI Mind Works'

# Absolute base for links and images inside those emails.
TECH_FRONTEND_URL=http://localhost:3000
