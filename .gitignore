# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but always commit the *example* templates so other devs know which keys
# to set.
!.env.example
!.env.*.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/tmp
.gocache/
backend/exam-engine/.gocache/

# build output
dist/
**/dist/
**/.next/
**/build/
**/coverage/

# IDEs and local assistant state
.idea/
.vscode/
.claude/
**/.claude/

# Local logs and generated reports
.logs/
logs/
*.log
eslint-report*.txt
backend/assessment-service/detailed-audit*.json

# Service build binaries. The deploy workflow builds these on the host; they
# were tracked, so every deploy carried a stale ~20MB binary that nothing ran.
backend/exam-engine/server
backend/exam-engine/exam-engine
backend/exam-engine/migrate
backend/exam-engine/migrate.exe
backend/tech-assessment-engine/tech-engine

# Local office/archive artifacts
*.doc
*.docx
*.zip
*.7z
*.rar

origin services.bat
# Local development scaffolding state (see local-dev/README.md)
local-dev/node_modules/
local-dev/cognito/db/

# Judge0 runtime config. Holds the API token and the sandbox's database and
# redis passwords; it was committed with live values until the separation.
# The template beside it documents every key.
backend/judge0/judge0.conf
!backend/judge0/judge0.conf.example
